// =============================================================================
// UD Drone VIP - Windows 11, native display via WSLg.
//
// This is the OPTIONAL fast path on Windows. The default "Universal" config is
// the recommended one; use this only if you want native rendering speed and
// are willing to troubleshoot. See ../compose.windows-wslg.yaml for why this
// path is inherently more fragile than the browser one.
//
// Requires: Windows 11, Docker Desktop on the WSL2 backend, and WSLg already
// working in a normal WSL distro (verify with `wsl -- xclock` FIRST).
//
// Falls back to the browser desktop on port 6080 if the socket is unreachable.
// =============================================================================
{
  "name": "Drone VIP - Windows (WSLg native display)",
  "dockerComposeFile": ["../compose.yaml", "../compose.windows-wslg.yaml"],
  "service": "dev",
  "workspaceFolder": "/workspaces/DroneSwarming",
  "overrideCommand": false,
  "remoteUser": "ros",
  "forwardPorts": [6080, 5901],
  "portsAttributes": {
    "6080": { "label": "Simulation GUI (browser)", "onAutoForward": "notify" },
    "5901": { "label": "Simulation GUI (VNC client)", "onAutoForward": "silent" }
  },
  "customizations": {
    "vscode": {
      "extensions": [
        "ms-python.python",
        "ms-python.vscode-pylance",
        "ms-vscode.cpptools",
        "ms-vscode.cmake-tools",
        "ms-iot.vscode-ros",
        "redhat.vscode-yaml"
      ],
      "settings": {
        "terminal.integrated.defaultProfile.linux": "bash",
        "python.defaultInterpreterPath": "/usr/bin/python3",
        "files.associations": {
          "*.sdf": "xml",
          "*.world": "xml",
          "*.urdf": "xml"
        }
      }
    }
  },
  "postCreateCommand": "bash .devcontainer/scripts/post-create.sh",
  "postStartCommand": "bash /opt/drone-vip/scripts/start-display.sh",
  "waitFor": "postCreateCommand"
}
