// =============================================================================
// UD Drone VIP development container.
//
// Works the same way on Windows, macOS (Intel and Apple Silicon), and Linux,
// with nothing to install on the host beyond Docker and VS Code.
//
// The container runs its own desktop for the Gazebo and rviz GUI. Reach it at
// http://localhost:6080 in a browser, or on localhost:5901 with a VNC client.
// VirtualGL renders through the GPU when the machine has one.
// =============================================================================
{
  "name": "UD Drone VIP",
  "dockerComposeFile": ["compose.yaml"],
  "service": "dev",
  "workspaceFolder": "/workspaces/DroneSwarming",
  "overrideCommand": false,
  "remoteUser": "ros",

  // NO forwardPorts here on purpose. compose.yaml already publishes 6080 and
  // 5901 to 127.0.0.1, and having VS Code forward them as well makes the two
  // mechanisms fight over the same host port. "ignore" stops VS Code binding
  // them a second time; the URL below still works because compose published it.
  "portsAttributes": {
    "6080": { "label": "Simulation GUI", "onAutoForward": "ignore" },
    "5901": { "label": "Simulation GUI (VNC client)", "onAutoForward": "ignore" }
  },
  "otherPortsAttributes": { "onAutoForward": "silent" },

  "customizations": {
    "vscode": {
      "extensions": [
        "ms-python.python",
        "ms-python.vscode-pylance",
        "ms-vscode.cpptools",
        "ms-vscode.cmake-tools",
        "ms-iot.vscode-ros",
        "redhat.vscode-yaml"
      ],
      "settings": {
        "terminal.integrated.defaultProfile.linux": "bash",
        "python.defaultInterpreterPath": "/usr/bin/python3",
        "files.associations": {
          "*.sdf": "xml",
          "*.world": "xml",
          "*.urdf": "xml"
        }
      }
    }
  },

  "postCreateCommand": "bash .devcontainer/scripts/post-create.sh",
  // The desktop is started by the container itself (see compose.yaml), so the
  // GUI never depends on this hook firing. drone-gui reports where to find it
  // and, if it finds the desktop down, starts it. Idempotent either way, so
  // running it here costs nothing and a hook that never fires costs nothing.
  "postStartCommand": "drone-gui",
  "waitFor": "postCreateCommand"
}
