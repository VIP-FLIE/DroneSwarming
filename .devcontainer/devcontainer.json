// =============================================================================
// UD Drone VIP - DEFAULT configuration. Start here.
//
// Works on every supported host with NO host-side setup at all:
//   Windows 11 (with or without an NVIDIA GPU), macOS Intel, macOS Apple
//   Silicon, any Linux distro, and headless/SSH machines.
//
// The GUI is served BY THE CONTAINER over HTTP. After the container starts,
// open http://localhost:6080 and the Gazebo/rviz windows are there.
// No XQuartz, no VcXsrv, no WSLg, no X forwarding.
//
// Rendering is Mesa llvmpipe (software). That costs GUI framerate, but NOT
// simulation accuracy: physics is CPU-bound and still runs at a real-time
// factor of ~1.0 for the worlds this team uses.
//
// Want native speed? Use the "Linux (native X11)" or "Windows (WSLg)"
// configuration instead. Run ./scripts/doctor.sh and it will tell you which
// one your machine can support.
// =============================================================================
{
  "name": "Drone VIP - Universal (browser GUI)",
  "dockerComposeFile": ["compose.yaml"],
  "service": "dev",
  "workspaceFolder": "/workspaces/DroneSwarming",
  "overrideCommand": false,
  "remoteUser": "ros",
  "forwardPorts": [6080, 5901],
  "portsAttributes": {
    "6080": { "label": "Simulation GUI (browser)", "onAutoForward": "notify" },
    "5901": { "label": "Simulation GUI (VNC client)", "onAutoForward": "silent" }
  },
  "customizations": {
    "vscode": {
      "extensions": [
        "ms-python.python",
        "ms-python.vscode-pylance",
        "ms-vscode.cpptools",
        "ms-vscode.cmake-tools",
        "ms-iot.vscode-ros",
        "redhat.vscode-yaml"
      ],
      "settings": {
        "terminal.integrated.defaultProfile.linux": "bash",
        "python.defaultInterpreterPath": "/usr/bin/python3",
        "files.associations": {
          "*.sdf": "xml",
          "*.world": "xml",
          "*.urdf": "xml"
        }
      }
    }
  },
  "postCreateCommand": "bash .devcontainer/scripts/post-create.sh",
  "postStartCommand": "bash /opt/drone-vip/scripts/start-display.sh",
  "waitFor": "postCreateCommand"
}
