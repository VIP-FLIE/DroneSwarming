// =============================================================================
// UD Drone VIP development container.
//
// There is only one configuration, on purpose. It works the same way on
// Windows, macOS (Intel and Apple Silicon), and Linux, with nothing to install
// on the host beyond Docker and VS Code.
//
// The Gazebo/rviz GUI is served by the container to your browser at
// http://localhost:6080. VirtualGL renders through the GPU when the machine
// has one, so this is not a slow fallback path, it is the fast path too.
// =============================================================================
{
  "name": "UD Drone VIP",
  "dockerComposeFile": ["compose.yaml"],
  "service": "dev",
  "workspaceFolder": "/workspaces/DroneSwarming",
  "overrideCommand": false,
  "remoteUser": "ros",

  // NO forwardPorts here on purpose. compose.yaml already publishes 6080 and
  // 5901 to 127.0.0.1, and having VS Code forward them as well makes the two
  // mechanisms fight over the same host port. "ignore" stops VS Code binding
  // them a second time; the URL below still works because compose published it.
  "portsAttributes": {
    "6080": { "label": "Simulation GUI", "onAutoForward": "ignore" },
    "5901": { "label": "Simulation GUI (VNC client)", "onAutoForward": "ignore" }
  },
  "otherPortsAttributes": { "onAutoForward": "silent" },

  "customizations": {
    "vscode": {
      "extensions": [
        "ms-python.python",
        "ms-python.vscode-pylance",
        "ms-vscode.cpptools",
        "ms-vscode.cmake-tools",
        "ms-iot.vscode-ros",
        "redhat.vscode-yaml"
      ],
      "settings": {
        "terminal.integrated.defaultProfile.linux": "bash",
        "python.defaultInterpreterPath": "/usr/bin/python3",
        "files.associations": {
          "*.sdf": "xml",
          "*.world": "xml",
          "*.urdf": "xml"
        }
      }
    }
  },

  "postCreateCommand": "bash .devcontainer/scripts/post-create.sh",
  // The desktop is started by the container itself (see compose.yaml).
  // This only reports where to find it, so a failed hook cannot cost you the GUI.
  "postStartCommand": "drone-gui",
  "waitFor": "postCreateCommand"
}
