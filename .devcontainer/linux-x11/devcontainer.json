// =============================================================================
// UD Drone VIP - Linux host, native X11 display. FASTEST option on Linux.
//
// Draws straight onto your desktop using the host X server, with real GPU
// acceleration. Works on X11 sessions and on Wayland sessions (via XWayland).
//
// Requires: a graphical Linux session (an X socket at /tmp/.X11-unix).
// For GPU: install the NVIDIA Container Toolkit, then run ./scripts/doctor.sh
// to write the right .env.
//
// If the X socket turns out to be unreachable, the container does NOT fail --
// it falls back to the browser desktop on port 6080.
// =============================================================================
{
  "name": "Drone VIP - Linux (native X11 + GPU)",
  "dockerComposeFile": ["../compose.yaml", "../compose.linux-x11.yaml"],
  "service": "dev",
  "workspaceFolder": "/workspaces/DroneSwarming",
  "overrideCommand": false,
  "remoteUser": "ros",
  "forwardPorts": [6080, 5901],
  "portsAttributes": {
    "6080": { "label": "Simulation GUI (browser)", "onAutoForward": "notify" },
    "5901": { "label": "Simulation GUI (VNC client)", "onAutoForward": "silent" }
  },
  "customizations": {
    "vscode": {
      "extensions": [
        "ms-python.python",
        "ms-python.vscode-pylance",
        "ms-vscode.cpptools",
        "ms-vscode.cmake-tools",
        "ms-iot.vscode-ros",
        "redhat.vscode-yaml"
      ],
      "settings": {
        "terminal.integrated.defaultProfile.linux": "bash",
        "python.defaultInterpreterPath": "/usr/bin/python3",
        "files.associations": {
          "*.sdf": "xml",
          "*.world": "xml",
          "*.urdf": "xml"
        }
      }
    }
  },
  "postCreateCommand": "bash .devcontainer/scripts/post-create.sh",
  "postStartCommand": "bash /opt/drone-vip/scripts/start-display.sh",
  "waitFor": "postCreateCommand"
}
