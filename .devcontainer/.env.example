# =============================================================================
# Copy this file to .devcontainer/.env and edit, OR just run:
#     ./scripts/doctor.sh      (Linux / macOS)
# which detects your machine and writes .env for you.
#
# Docker Compose reads .devcontainer/.env automatically. It is gitignored, so
# your machine-specific settings never end up in someone else's checkout --
# which is the whole point: identical repo, per-machine adaptation.
# =============================================================================

# --- Image -------------------------------------------------------------------
# Leave unset to build the image locally on first use (~30 min, once).
# Point it at the team's published image to skip building entirely.
#DRONE_IMAGE=ghcr.io/YOUR-ORG/droneswarming-dev:jazzy

# Set to 0 to build a smaller image that compiles PX4 on first container start
# instead of during the image build. Only useful if you are iterating on the
# Dockerfile itself.
#PREBUILD_PX4=1

# --- GPU ---------------------------------------------------------------------
# Only set these if `docker info` lists an `nvidia` runtime, i.e. you have the
# NVIDIA Container Toolkit installed. Setting them without it makes the
# container fail to start.
#DOCKER_RUNTIME=nvidia
#NVIDIA_VISIBLE_DEVICES=all
#NVIDIA_DRIVER_CAPABILITIES=all

# --- Display ---------------------------------------------------------------
# Resolution of the container's desktop.
#DRONE_VNC_GEOMETRY=1600x900

# Host ports for the desktop. 6080 is the browser view, 5901 is for a VNC
# client. Change either if something else on your machine already uses it.
#DRONE_NOVNC_PORT=6080
#DRONE_VNC_PORT=5901

# Password on the desktop. Off by default because the ports are bound to
# 127.0.0.1 only. Set one if you connect with macOS Screen Sharing, which
# refuses a desktop that has no password, or if you publish the ports anywhere
# beyond your own machine. Rebuild the container after changing this.
#DRONE_VNC_PASSWORD=

# Set to 0 to bypass VirtualGL if you ever suspect it of causing trouble.
# You will drop to software rendering.
#DRONE_VGL=1

# --- ROS ---------------------------------------------------------------------
# Give every teammate a DIFFERENT id if you are on the same network, or your
# nodes will discover each other's drones. 0-101 are valid.
#ROS_DOMAIN_ID=0
#RMW_IMPLEMENTATION=rmw_fastrtps_cpp
