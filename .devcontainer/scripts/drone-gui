#!/usr/bin/env bash
# drone-gui           say whether the browser desktop is up, and where
# drone-gui restart   tear it down and start it again
set -o pipefail

PORT="${DRONE_NOVNC_HOST_PORT:-6080}"
VNC_PORT="${DRONE_VNC_PORT:-5901}"

if [ "${1:-}" = "restart" ]; then
    echo "stopping the desktop..."
    pkill -f websockify 2>/dev/null
    pkill -f x11vnc 2>/dev/null
    pkill -f openbox 2>/dev/null
    pkill -f "Xvfb :1" 2>/dev/null
    sleep 2
fi

if ! pgrep -f "Xvfb :1" >/dev/null 2>&1 || ! pgrep -f websockify >/dev/null 2>&1; then
    echo "desktop is not running, starting it..."
    for sd in /workspaces/DroneSwarming/.devcontainer/scripts/start-display.sh \
              /opt/drone-vip/scripts/start-display.sh; do
        [ -r "$sd" ] && { bash "$sd"; break; }
    done
    echo
fi

printf 'Xvfb       : %s\n' "$(pgrep -f 'Xvfb :1' >/dev/null 2>&1 && echo running || echo STOPPED)"
printf 'openbox    : %s\n' "$(pgrep -f openbox    >/dev/null 2>&1 && echo running || echo STOPPED)"
printf 'x11vnc     : %s\n' "$(pgrep -f x11vnc     >/dev/null 2>&1 && echo running || echo STOPPED)"
printf 'noVNC      : %s\n' "$(pgrep -f websockify >/dev/null 2>&1 && echo running || echo STOPPED)"

if (exec 3<>/dev/tcp/127.0.0.1/6080) 2>/dev/null; then
    printf 'listening  : yes\n\n'
    printf 'View the desktop either way:\n'
    printf '  browser     http://localhost:%s\n' "$PORT"
    printf '  VNC client  localhost:%s\n' "$VNC_PORT"
else
    printf 'listening  : NO\n\nSomething failed. The full log is at /tmp/drone-display.log:\n'
    tail -20 /tmp/drone-display.log 2>/dev/null | sed 's/^/    /'
fi
