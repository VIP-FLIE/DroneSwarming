<?xml version="1.0"?>
<package format="3">
  <name>vehicle_control</name>
  <version>0.1.0</version>
  <description>Reusable ROS 2 flight actions backed by PX4 Offboard control.</description>
  <maintainer email="maintainer@example.com">DroneSwarming maintainers</maintainer>
  <license>BSD-3-Clause</license>
  <buildtool_depend>ament_cmake</buildtool_depend>
  <depend>geometry_msgs</depend>
  <depend>px4_msgs</depend>
  <depend>rclcpp</depend>
  <depend>rclcpp_action</depend>
  <depend>swarm_interfaces</depend>
  <test_depend>ament_cmake_gtest</test_depend>
  <test_depend>ament_index_python</test_depend>
  <test_depend>action_msgs</test_depend>
  <test_depend>rcl_interfaces</test_depend>
  <test_depend>rclpy</test_depend>
  <test_depend>rosidl_runtime_py</test_depend>
  <export>
    <build_type>ament_cmake</build_type>
  </export>
