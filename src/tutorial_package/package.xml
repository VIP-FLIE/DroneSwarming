<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>

<!--
  package.xml tells colcon (the ROS 2 build tool) about this package.
  colcon reads it to:
    - know the package name
    - find what to build first (dependencies)
    - know what kind of package this is (C++ vs Python)

  The <name> here must match three other things exactly:
    - the directory name:        src/tutorial_package/
    - project() in CMakeLists:  project(tutorial_package)
  If any of those disagree, colcon cannot find or build the package.
-->
<package format="3">
  <name>tutorial_package</name>
  <version>0.1.0</version>
  <description>Minimal C++ ROS 2 node. A starting point for your own package.</description>
  <maintainer email="you@example.com">Your Name</maintainer>
  <license>MIT</license>

  <!--
    ament_cmake is the C++ build system wrapper ROS 2 uses. It is always a
    buildtool_depend (needed at build time only, not at runtime).
  -->
  <buildtool_depend>ament_cmake</buildtool_depend>

  <!--
    rclcpp is the C++ ROS 2 client library. It is the only thing this node
    uses. <depend> covers both build time and runtime.

    When you add more dependencies (e.g. px4_msgs), add a <depend> line here
    for each one. colcon uses these to decide build order; missing them causes
    hard-to-diagnose link errors on a fresh checkout.
  -->
  <depend>rclcpp</depend>

  <!--
    ament_cmake means C++. The alternative is ament_python for Python packages.
    A package is one or the other, not both.
  -->
  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
