# At least two points are required. Times start at zero and increase strictly.
swarm_interfaces/TrajectoryPoint[] points
# Set true to command each point's yaw. False leaves yaw control to PX4.
bool control_yaw
# Zero selects the configured default. Units are meters.
float32 position_tolerance_m
# Used when control_yaw is true. Zero selects the configured default. Units are radians.
float32 yaw_tolerance_rad
# Zero selects the configured default. Units are seconds.
float32 timeout_sec
---
bool success
string message
float32 final_distance_m
# NaN when control_yaw is false or measured yaw is unavailable.
float32 final_yaw_error_rad
---
float32 elapsed_sec
float32 distance_to_target_m
# NaN when control_yaw is false.
float32 yaw_error_rad
string status
