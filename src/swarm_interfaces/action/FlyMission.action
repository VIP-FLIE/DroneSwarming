# Internal vehicle-control request. All destinations are fixed WGS84/AMSL positions.
# The captured geographic start bounds takeoff and detects movement before arming.
swarm_interfaces/GeographicPosition starting_position
swarm_interfaces/GeographicPosition takeoff_position
swarm_interfaces/GeographicPosition[] waypoint_positions
float32 position_tolerance_m
float32 waypoint_timeout_sec
bool look_at_point_of_interest
swarm_interfaces/GeographicPosition look_at_position
bool land_after_waypoints
---
bool success
uint32 completed_waypoints
string message
---
uint32 current_waypoint
uint32 completed_waypoints
float32 distance_to_target_m
string status
