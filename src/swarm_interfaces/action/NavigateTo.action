# Absolute position in local_enu (East, North, Up), relative to the PX4 local origin.
geometry_msgs/Point target_position
# When true, set yaw toward the horizontal bearing from the current position to this point.
bool look_at_target
# Absolute point in local_enu. Its horizontal coordinates determine yaw; its height does not.
# The goal is rejected if this point is within 0.1 m of the destination horizontally.
geometry_msgs/Point look_at_position
string frame_id
# Zero selects the configured default. Units are meters.
float32 position_tolerance_m
# Zero selects the configured default. Units are seconds.
float32 timeout_sec
---
bool success
string message
float32 final_distance_m
# Final yaw error in radians. NaN means no yaw error was measured.
float32 final_yaw_error_rad
---
float32 distance_to_target_m
