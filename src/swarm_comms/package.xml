<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>swarm_comms</name>
  <version>0.1.0</version>
  <description>
    Worked example: the same PX4 swarm as swarm_naive, except the drones tell
    each other where they are. A readiness barrier replaces a shared clock, and
    each drone's target is a function of the position of the drone ahead of it.
    Read it alongside docs/SWARM.md, and diff it against swarm_naive.
  </description>
  <maintainer email="dmihovch@udel.edu">UD Drone VIP</maintainer>
  <license>MIT</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <!-- Generates C++ from msg/SwarmState.msg at build time. -->
  <buildtool_depend>rosidl_default_generators</buildtool_depend>
  <!-- The type support the generated code needs when the node actually runs. -->
  <exec_depend>rosidl_default_runtime</exec_depend>
  <!-- Marks this as a package that defines interfaces. Without it the generated
       message is not registered and other packages cannot import it. -->
  <member_of_group>rosidl_interface_packages</member_of_group>

  <depend>px4_msgs</depend>
  <depend>rclcpp</depend>

  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
