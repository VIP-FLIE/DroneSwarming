#!/usr/bin/env bash
# drone-sim   Launch PX4 SITL with the x500 in Gazebo.
#
#   drone-sim                 x500, Gazebo window on your desktop
#   drone-sim gz_x500_mono_cam  a different PX4 model
#   HEADLESS=1 drone-sim      no Gazebo window, for swarms and long runs
#
# On a shared machine, PX4_INSTANCE_BASE (from DRONE_SLOT, see
# scripts/native/env.sh) moves this vehicle off instance 0 so it does not
# collide with everybody else's. See the bottom of this file and
# docs/LAB-SERVER.md.
#
# `gz sim` on its own does not start the drone. It opens Gazebo's world
# chooser, which lists demo worlds and has nothing to do with PX4. The vehicle
# is spawned by PX4's own build target, which is what this runs.
#
# This script is a convenience, and it hides what the stack is made of. The
# whole of it, without this file, is one environment variable and a binary:
#
#     cd ~/PX4-Autopilot && PX4_SIM_MODEL=gz_x500 ./build/px4_sitl_default/bin/px4
#
# docs/UNDER-THE-SCRIPTS.md takes this apart line by line and says which of
# these processes also runs on a real aircraft.
#
# THERE ARE TWO OF THESE, AND THAT IS DELIBERATE
# ----------------------------------------------
# This is the native copy. The container's is .devcontainer/scripts/drone-sim.
# They share three working lines (PX4_DIR, unset PX4_GZ_STANDALONE, and the
# `cd` + `make`); everything else differs because the environments genuinely
# do:
#
#   container   sources /tmp/drone-display.env and starts the browser desktop,
#               since Gazebo renders to a virtual display. PX4 is baked into
#               the image, so there is nothing to check.
#   native      no virtual display, Gazebo opens on your desktop. You installed
#               PX4 yourself, so it checks that it is there and built.
#
# drone-gcs is the other way round: the native copy is a three-line shim that
# execs the container's Python, because 150 lines of MAVLink logic is worth
# having exactly one copy of. Three lines of environment setup is not.
set -o pipefail

export PX4_DIR="${PX4_DIR:-$HOME/PX4-Autopilot}"
export GZ_SIM_RESOURCE_PATH="$PX4_DIR/Tools/simulation/gz/models:$PX4_DIR/Tools/simulation/gz/worlds"

# PX4 treats this as present-or-absent, not 1-or-0, so even PX4_GZ_STANDALONE=0
# makes PX4 sit waiting for a Gazebo server nothing started.
unset PX4_GZ_STANDALONE

MODEL="${1:-gz_x500}"

if [ ! -d "$PX4_DIR" ]; then
    echo "No PX4 source at $PX4_DIR. Run ./scripts/native/install.sh" >&2
    exit 1
fi

if [ ! -x "$PX4_DIR/build/px4_sitl_default/bin/px4" ]; then
    echo "PX4 is not built yet, so this will compile it first (10 to 30 minutes)."
    echo "Ctrl-C and run ./scripts/native/install.sh instead if you would rather"
    echo "see the build with its progress reporting."
    echo
fi

echo "Launching PX4 SITL with $MODEL."
[ -n "${HEADLESS:-}" ] && echo "HEADLESS is set, so no Gazebo window will open."
echo "First launch takes a minute while Gazebo loads its assets."
echo
cd "$PX4_DIR" || exit 1

# On your own machine PX4_INSTANCE_BASE is 0 and this is the plain `make`
# target, unchanged, which also builds PX4 if you have not yet.
if [ "${PX4_INSTANCE_BASE:-0}" -eq 0 ]; then
    exec make px4_sitl "$MODEL"
fi

# On a shared machine it cannot be. `make px4_sitl` runs the px4 binary with no
# -i, which is instance 0, which is the same instance for everybody on the
# machine and therefore the same MAVLink GCS port (18570). The second person to
# start gets a vehicle with no GCS link and an "Arming denied" it did not earn.
#
# There is no way to pass an instance through the make target: the run rule is
# `COMMAND $<TARGET_FILE:px4>` in platforms/posix/CMakeLists.txt with nothing
# in between. So run the binary the way the swarm launch files already do,
# from the PX4 tree, with -i. PX4 resolves its ROMFS from the binary's own
# location and keeps per-instance state in build/px4_sitl_default/rootfs/<i>,
# so the working directory here is the same one `make` would have used.
#
# PX4_SIM_MODEL alone is enough. rcS looks the airframe id up by scanning
# etc/init.d-posix/airframes for [0-9]+_$PX4_SIM_MODEL, so this stays correct
# for any model name make would have accepted.
if [ ! -x "$PX4_DIR/build/px4_sitl_default/bin/px4" ]; then
    echo "PX4 is not built, and on a shared machine this script cannot build it" >&2
    echo "for you without also running it as instance 0. Run:" >&2
    echo "    ./scripts/native/install.sh" >&2
    exit 1
fi

INSTANCE=$((PX4_INSTANCE_BASE + 1))
echo "Slot ${DRONE_SLOT:-?}, so this is SITL instance $INSTANCE."
echo "Its topics are under /px4_$INSTANCE/fmu/, and its GCS port is $((18570 + INSTANCE))."
echo
export PX4_SIM_MODEL="$MODEL"
exec "$PX4_DIR/build/px4_sitl_default/bin/px4" -i "$INSTANCE"
