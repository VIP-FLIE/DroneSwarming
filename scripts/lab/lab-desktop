#!/usr/bin/env bash
# =============================================================================
# Your desktop on the shared lab machine.
#
#   lab-desktop           start it if it is not up, then say where it is
#   lab-desktop status    say where it is, start nothing
#   lab-desktop restart   tear it down and start it again
#   lab-desktop stop      tear it down
#
# Gazebo needs somewhere to draw. On the lab machine nobody is sitting at the
# console, so there is no desktop to draw on until you make one. This starts a
# TurboVNC X server that belongs to you, puts a window manager on it, and
# publishes it two ways: to a VNC client, and over HTTP for a browser. You
# reach either one through your SSH tunnel.
#
# Rendering goes through the NVIDIA card. The `gz` wrappers that
# scripts/lab/install-lab.sh puts in place run it under `vglrun -d egl`, which
# renders on the GPU through an EGL device and needs no X server of its own.
# That is the same path the dev container uses.
#
# THIS IS THE LAB MACHINE'S drone-gui
# -----------------------------------
# .devcontainer/scripts/drone-gui does this job inside the container, with Xvfb
# and x11vnc. Same shape, same two views, same idempotence. It differs in three
# ways, all of them because this machine is shared and that one is not:
#
#   per user    display, ports and ~/.vnc all come from DRONE_SLOT
#   password    required, because on a shared machine localhost is not a
#               trust boundary. Another logged-in user can reach your port
#   TurboVNC    rather than Xvfb plus x11vnc, because it is markedly faster
#               on 3D content and this is the one machine with a GPU to feed
#
# Full guide: docs/setup/LAB-SERVER.md
# =============================================================================
set -o pipefail

TURBOVNC=/opt/TurboVNC/bin
GEOMETRY="${DRONE_LAB_GEOMETRY:-1600x900}"

# Slot 0 is the default so this still does something sensible on a machine with
# one user. docs/setup/LAB-SERVER.md has the table these come from.
SLOT="${DRONE_SLOT:-0}"
case "$SLOT" in
    [0-9]) ;;
    *) echo "DRONE_SLOT must be a single digit 0-9, got '$SLOT'." >&2
       echo "Set it in ~/.bashrc, above the line that sources env.sh." >&2
       exit 1 ;;
esac

DISPLAY_NUM=$((10 + SLOT))
VNC_PORT=$((5900 + DISPLAY_NUM))
NOVNC_PORT=$((6080 + SLOT))
XSTARTUP="$HOME/.vnc/xstartup.turbovnc"

die()  { printf '\n%s\n\n' "$*" >&2; exit 1; }

vnc_running() {
    # TurboVNC's own bookkeeping rather than pgrep, so a stale pid file is
    # reported the way vncserver itself sees it.
    "$TURBOVNC/vncserver" -list 2>/dev/null | grep -q "^:${DISPLAY_NUM}[[:space:]]"
}

novnc_running() {
    pgrep -u "$(id -u)" -f "websockify.*:$NOVNC_PORT " >/dev/null 2>&1 \
      || pgrep -u "$(id -u)" -f "websockify.*[^0-9]$NOVNC_PORT " >/dev/null 2>&1
}

stop_desktop() {
    echo "stopping your desktop on :$DISPLAY_NUM..."
    # -u so this can only ever reach your own processes. Another user's
    # desktop is none of this script's business, and on a shared machine that
    # distinction is the whole point.
    pkill -u "$(id -u)" -f "websockify.*$NOVNC_PORT" 2>/dev/null
    "$TURBOVNC/vncserver" -kill ":$DISPLAY_NUM" >/dev/null 2>&1
    sleep 1
}

report() {
    printf '\n'
    printf 'slot        : %s\n' "$SLOT"
    printf 'display     : :%s\n' "$DISPLAY_NUM"
    printf 'Xvnc        : %s\n' "$(vnc_running   && echo running || echo STOPPED)"
    printf 'noVNC       : %s\n' "$(novnc_running && echo running || echo STOPPED)"

    if ! vnc_running; then
        printf '\nNothing is serving your desktop. Start it with: lab-desktop\n'
        return
    fi

    cat <<REPORT

Run this on YOUR OWN machine, in a second terminal:

    ssh -L $VNC_PORT:localhost:$VNC_PORT -L $NOVNC_PORT:localhost:$NOVNC_PORT $USER@flie-lab

Then view the desktop either way:

    VNC client  localhost:$VNC_PORT        (TurboVNC Viewer, turbovnc.org)
    browser     http://localhost:$NOVNC_PORT/vnc.html?autoconnect=1&resize=remote

Both ask for the VNC password you set with $TURBOVNC/vncpasswd.
Put the two -L options in ~/.ssh/config and you never type them again.
Anything you run needs DISPLAY set, which sourcing env.sh does not do:

    export DISPLAY=:$DISPLAY_NUM
REPORT
}

case "${1:-start}" in
    status) report; exit 0 ;;
    stop)   stop_desktop; report; exit 0 ;;
    restart) stop_desktop ;;
    start)  ;;
    *) echo "usage: lab-desktop [status|start|restart|stop]" >&2; exit 2 ;;
esac

[ -x "$TURBOVNC/vncserver" ] || die "No TurboVNC at $TURBOVNC.
An administrator runs scripts/lab/install-lab.sh once to put it there."

# A password is not optional here. -localhost limits the port to this machine,
# and on a machine five people are logged into that is not a limit worth much.
if [ ! -f "$HOME/.vnc/passwd" ]; then
    die "You have no VNC password yet. Set one, then run this again:

    $TURBOVNC/vncpasswd

It is not your account password and it does not need to be. It stops the other
people logged into this machine from opening your desktop. Say no when it
offers to set a view-only password, you do not need one."
fi

# openbox rather than a full desktop environment: this exists to hold a Gazebo
# window, and five GNOME sessions on one machine is CPU spent on nothing. Same
# choice .devcontainer makes. `exec` because TurboVNC ends the session when
# xstartup returns.
if [ ! -f "$XSTARTUP" ]; then
    echo "writing $XSTARTUP"
    mkdir -p "$HOME/.vnc"
    cat > "$XSTARTUP" <<'XEOF'
#!/bin/sh
# Written by scripts/lab/lab-desktop. Edit it if you want a different window
# manager; lab-desktop will not overwrite a file that already exists.
unset SESSION_MANAGER
unset DBUS_SESSION_BUS_ADDRESS
exec openbox
XEOF
    chmod +x "$XSTARTUP"
fi

if vnc_running; then
    echo "desktop already running on :$DISPLAY_NUM"
else
    echo "starting TurboVNC on :$DISPLAY_NUM (${GEOMETRY})"
    # -localhost so the port is reachable only through the SSH tunnel.
    # -securitytypes VNC because that is the one noVNC in the browser and the
    # TurboVNC Viewer both speak without further setup.
    if ! "$TURBOVNC/vncserver" ":$DISPLAY_NUM" \
            -geometry "$GEOMETRY" -depth 24 \
            -localhost -securitytypes VNC; then
        die "TurboVNC would not start on :$DISPLAY_NUM.
Its log is the one named in the output above, usually
~/.vnc/$(hostname):$DISPLAY_NUM.log"
    fi
fi

if novnc_running; then
    echo "noVNC already running on $NOVNC_PORT"
else
    echo "starting noVNC on $NOVNC_PORT"
    # Bound to 127.0.0.1 for the same reason as -localhost above: the only way
    # in is the SSH tunnel.
    nohup websockify --web=/usr/share/novnc \
          "127.0.0.1:$NOVNC_PORT" "localhost:$VNC_PORT" \
          > "$HOME/.vnc/novnc-$NOVNC_PORT.log" 2>&1 &
    disown
    for _ in $(seq 1 20); do
        novnc_running && break
        sleep 0.25
    done
    novnc_running || echo "  noVNC did not come up. See ~/.vnc/novnc-$NOVNC_PORT.log" >&2
fi

report
