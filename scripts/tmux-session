#!/usr/bin/env bash
set -Eeuo pipefail

usage() {
    printf 'Usage: %s [--help]\n' "${0##*/}"
}

if [[ "${1:-}" == -h || "${1:-}" == --help ]]; then
    usage
    exit 0
fi

if (($# != 0)); then
    usage >&2
    exit 2
fi

if [[ -f /.dockerenv || -f /run/.containerenv || -n "${REMOTE_CONTAINERS:-}" ]]; then
    printf 'Run this script from a native host terminal, outside the project container.\n' >&2
    exit 1
fi

if ! command -v tmux >/dev/null 2>&1; then
    printf 'tmux is required on the host. Install it with: sudo apt install tmux\n' >&2
    exit 127
fi

repository_root="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.." && pwd)"
session_name='drone-swarming'

pane_titles=(
    'XRCE-DDS Agent'
    'PX4 SITL + Gazebo'
    'Application Launch'
    'ROS 2 CLI'
)

run_id=''
session_exists=0
if tmux has-session -t "$session_name" 2>/dev/null; then
    session_exists=1
    session_environment="$(tmux show-environment -t "$session_name" DRONE_RUN_ID 2>/dev/null || true)"
    if [[ "$session_environment" == DRONE_RUN_ID=* ]]; then
        run_id="${session_environment#DRONE_RUN_ID=}"
    else
        printf 'The existing tmux session has no DRONE_RUN_ID. Close it with `tmux kill-session -t %s` and start a new session.\n' "$session_name" >&2
        exit 1
    fi
    if [[ ! "$run_id" =~ ^[0-9]{8}T[0-9]{6}Z(-[1-9][0-9]*)?$ ]] ||
        [[ ! -d "$repository_root/run-logs/$run_id" ]]; then
        printf 'The existing tmux session has an invalid or missing run directory: %s\n' "$run_id" >&2
        exit 1
    fi
else
    run_id="$("$repository_root/scripts/new-run")"
fi

printf -v agent_command 'exec env DRONE_RUN_ID=%q DRONE_LOG_ROLE=%q %q' \
    "$run_id" 'xrce-agent' "$repository_root/scripts/xrce-agent"
printf -v px4_command 'exec env DRONE_RUN_ID=%q DRONE_LOG_ROLE=%q %q' \
    "$run_id" 'px4-sitl' "$repository_root/scripts/px4-sitl"
printf -v application_command 'exec env DRONE_RUN_ID=%q DRONE_LOG_ROLE=%q %q' \
    "$run_id" 'application' "$repository_root/scripts/sim-shell"
printf -v cli_command 'exec env DRONE_RUN_ID=%q DRONE_LOG_ROLE=%q %q' \
    "$run_id" 'ros-cli' "$repository_root/scripts/sim-shell"

pane_commands=(
    "$agent_command"
    "$px4_command"
    "$application_command"
    "$cli_command"
)

session_created=0
cleanup_failed_session() {
    local command_status=$?

    trap - EXIT
    if [[ "$command_status" -ne 0 && "$session_created" -eq 1 ]]; then
        tmux kill-session -t "$session_name" 2>/dev/null || true
    fi
    exit "$command_status"
}
trap cleanup_failed_session EXIT

if [[ "$session_exists" -eq 0 ]]; then
    printf 'Run ID: %s\nLogs: %s\n' "$run_id" "$repository_root/run-logs/$run_id"
    "$repository_root/scripts/sim" up -d simulation
    tmux new-session -d -s "$session_name" -c "$repository_root" \
        -e "DRONE_RUN_ID=$run_id" "$agent_command"
    session_created=1
    tmux set-environment -t "$session_name" DRONE_RUN_ID "$run_id"
    tmux select-pane -t "$session_name:0.0" -T "${pane_titles[0]}"
fi

mapfile -t existing_pane_ids < <(tmux list-panes -t "$session_name:0" -F '#{pane_id}')
mapfile -t existing_pane_titles < <(tmux list-panes -t "$session_name:0" -F '#{pane_title}')
pane_ids_by_role=()

for role_index in "${!pane_titles[@]}"; do
    pane_found=0
    for existing_index in "${!existing_pane_titles[@]}"; do
        if [[ "${existing_pane_titles[$existing_index]}" == "${pane_titles[$role_index]}" ]]; then
            pane_ids_by_role[$role_index]="${existing_pane_ids[$existing_index]}"
            pane_found=1
            break
        fi
    done

    if [[ "$pane_found" -eq 0 ]]; then
        pane_id="$(tmux split-window -P -F '#{pane_id}' -h -t "$session_name:0" -c "$repository_root" "${pane_commands[$role_index]}")"
        tmux select-pane -t "$pane_id" -T "${pane_titles[$role_index]}"
        existing_pane_ids+=("$pane_id")
        existing_pane_titles+=("${pane_titles[$role_index]}")
        pane_ids_by_role[$role_index]="$pane_id"
    fi
done

tmux select-layout -t "$session_name:0" tiled
tmux set-window-option -t "$session_name:0" pane-border-status top
tmux set-window-option -t "$session_name:0" pane-border-format '#{pane_index}: #{pane_title}'
tmux select-pane -t "${pane_ids_by_role[0]}" -T "${pane_titles[0]}"
tmux select-pane -t "${pane_ids_by_role[1]}" -T "${pane_titles[1]}"
tmux select-pane -t "${pane_ids_by_role[2]}" -T "${pane_titles[2]}"
tmux select-pane -t "${pane_ids_by_role[3]}" -T "${pane_titles[3]}"
tmux select-pane -t "${pane_ids_by_role[2]}"

trap - EXIT
exec tmux attach-session -t "$session_name"
