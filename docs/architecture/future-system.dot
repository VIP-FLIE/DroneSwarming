digraph FutureSystem {
  graph [
    bgcolor="#101820",
    fontcolor="#f8fafc",
    fontname="DejaVu Sans",
    fontsize=24,
    label="Planned system: flight intent and multi-vehicle search and rescue",
    labelloc=t,
    pad=0.4,
    rankdir=LR,
    ranksep=1.0,
    nodesep=0.7,
    splines=polyline
  ];
  node [
    color="#e2e8f0",
    fontcolor="#10212b",
    fontname="DejaVu Sans",
    fontsize=20,
    margin="0.24,0.16",
    penwidth=1.8,
    shape=box,
    style="rounded,filled"
  ];
  edge [
    color="#d7e3f4",
    fontcolor="#f8fafc",
    fontname="DejaVu Sans",
    fontsize=17,
    penwidth=2.3,
    arrowsize=1.15
  ];

  plan_file [label="JSON fleet file\nexplicit assignments", fillcolor="#ffd166"];
  operator [label="Planned operator\nspecial instructions", fillcolor="#ffd166", style="rounded,dashed,filled"];
  coordination [
    label="Planned swarm coordination\nassign / monitor / rebalance\n(protocol undefined)",
    fillcolor="#c084fc",
    style="rounded,dashed,filled"
  ];
  perception [label="Planned perception\ndetection results", fillcolor="#f0abfc", style="rounded,dashed,filled"];
  priority [label="Planned priority policy\n1. Safety landing\n2. Urgent special instructions\n3. Normal planned path", fillcolor="#fde047", style="rounded,dashed,filled"];

  subgraph cluster_fleet {
    label="Planned multi-vehicle fleet";
    color="#64748b";
    fillcolor="#17212b";
    fontcolor="#f8fafc";
    fontname="DejaVu Sans";
    fontsize=20;
    penwidth=1.8;
    style="rounded,dashed,filled";

    mission [label="mission_execution per vehicle\ncommand authority\nfuture intent arbitration", fillcolor="#22d3ee"];
    planner [label="mission_planner per vehicle\nselect + translate assignment", fillcolor="#7dd3fc"];
    control [label="vehicle_control per vehicle\nselected operation execution", fillcolor="#86efac"];
    px4 [label="PX4 per vehicle\ncontrol + preflight + failsafes", fillcolor="#bbf7d0"];
    mission -> control [label="selected operations"];
    control -> mission [label="vehicle state"];
    control -> px4 [dir=both, label="planned per-vehicle PX4 DDS", style=dashed];
  }

  plan_file -> mission [label="per-vehicle JSON submission"];
  mission -> planner [label="JSON + ID + state"];
  planner -> mission [label="translated instructions"];
  coordination -> mission [label="planned urgent workload rebalance", style=dashed];
  operator -> mission [label="planned urgent request", style=dashed];
  perception -> mission [label="planned detections affecting flight", style=dashed];
  mission -> coordination [label="planned health / task progress", style=dashed];
  priority -> mission [label="planned selection policy", style=dashed];
}
