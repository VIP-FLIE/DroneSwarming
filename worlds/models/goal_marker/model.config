<?xml version="1.0"?>
<!--
  Every Gazebo model is a directory with these two files in it. This one is
  what makes `model://goal_marker` resolve: Gazebo walks GZ_SIM_RESOURCE_PATH
  looking for a directory of this name that contains a model.config.
-->
<model>
  <name>goal_marker</name>
  <version>1.0</version>
  <sdf version="1.9">model.sdf</sdf>
  <author>
    <name>UD VIP Drone Swarm</name>
  </author>
  <description>
    A waypoint post you can see from the air. Used by worlds/vip_field.sdf as
    the smallest possible example of a model of your own.
  </description>
</model>
