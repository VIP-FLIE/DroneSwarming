<?xml version="1.0" encoding="UTF-8"?>
<!--
  vip_field.sdf   A worked example of a world you write yourself.

  The file name and the world name attribute below have to be the same string,
  "vip_field". PX4 starts Gazebo with the file, then waits for the world by
  name, so a mismatch hangs at "Waiting for Gazebo world..." and times out.

  Fly in it with:

      cd ~/PX4-Autopilot && PX4_GZ_WORLD=vip_field PX4_SIM_MODEL=gz_x500 ./build/px4_sitl_default/bin/px4

  after ./scripts/install-worlds.sh has put it where PX4 looks. The full
  explanation, and how to write your own, is in docs/simulation/WORLDS.md.

  Everything above the obstacles is copied unchanged from PX4's default.sdf:
  the physics step, gravity, the magnetic field and the latitude and longitude.
  Those four are the parts of a world the flight code can feel, so they are the
  parts you do not change casually. docs/simulation/WORLDS.md explains what
  each one costs you if you get it wrong.
-->
<sdf version="1.9">
  <world name="vip_field">

    <!-- 250 Hz physics, the rate PX4's lockstep scheduler expects. -->
    <physics type="ode">
      <max_step_size>0.004</max_step_size>
      <real_time_factor>1.0</real_time_factor>
      <real_time_update_rate>250</real_time_update_rate>
    </physics>
    <gravity>0 0 -9.8</gravity>

    <!-- Tesla, in ENU: east, north, up. What the simulated magnetometer
         reads, and it has to agree with the latitude and longitude below. -->
    <magnetic_field>6e-06 2.3e-05 -4.2e-05</magnetic_field>
    <atmosphere type="adiabatic"/>

    <scene>
      <sky/>
      <grid>true</grid>
      <ambient>0.4 0.4 0.4 1</ambient>
      <background>0.7 0.7 0.7 1</background>
      <shadows>true</shadows>
    </scene>

    <light name="sunUTC" type="directional">
      <pose>0 0 500 0 -0 0</pose>
      <cast_shadows>true</cast_shadows>
      <intensity>1</intensity>
      <direction>0.001 0.625 -0.78</direction>
      <diffuse>0.904 0.904 0.904 1</diffuse>
      <specular>0.271 0.271 0.271 1</specular>
      <attenuation>
        <range>2000</range>
        <linear>0</linear>
        <constant>1</constant>
        <quadratic>0</quadratic>
      </attenuation>
      <spot>
        <inner_angle>0</inner_angle>
        <outer_angle>0</outer_angle>
        <falloff>0</falloff>
      </spot>
    </light>

    <!-- The ground. The collision plane is infinite whatever <size> says;
         the size on the visual is how much of it you can see, 200 m here. -->
    <model name="ground_plane">
      <static>true</static>
      <link name="link">
        <collision name="collision">
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>1 1</size>
            </plane>
          </geometry>
          <surface>
            <friction>
              <ode/>
            </friction>
            <bounce/>
            <contact/>
          </surface>
        </collision>
        <visual name="visual">
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>200 200</size>
            </plane>
          </geometry>
          <material>
            <ambient>0.28 0.42 0.18 1</ambient>
            <diffuse>0.36 0.54 0.22 1</diffuse>
            <specular>0.05 0.05 0.05 1</specular>
          </material>
        </visual>
      </link>
    </model>

    <!-- Four pillars on a 20 m square, something for a formation to fly
         around and for you to see motion against. <static>true</static>
         keeps them out of the physics solver, which is free; drop it and
         Gazebo integrates them every step for no benefit. -->
    <model name="pillar_ne">
      <static>true</static>
      <pose>10 10 2.5 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>1 1 5</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>1 1 5</size></box></geometry>
          <material>
            <ambient>0.7 0.25 0.2 1</ambient>
            <diffuse>0.8 0.3 0.25 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <model name="pillar_nw">
      <static>true</static>
      <pose>-10 10 2.5 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>1 1 5</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>1 1 5</size></box></geometry>
          <material>
            <ambient>0.7 0.25 0.2 1</ambient>
            <diffuse>0.8 0.3 0.25 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <model name="pillar_se">
      <static>true</static>
      <pose>10 -10 2.5 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>1 1 5</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>1 1 5</size></box></geometry>
          <material>
            <ambient>0.7 0.25 0.2 1</ambient>
            <diffuse>0.8 0.3 0.25 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <model name="pillar_sw">
      <static>true</static>
      <pose>-10 -10 2.5 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>1 1 5</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>1 1 5</size></box></geometry>
          <material>
            <ambient>0.7 0.25 0.2 1</ambient>
            <diffuse>0.8 0.3 0.25 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <!-- A landing pad at the origin, where the x500 spawns. 4 cm thick, so
         the drone starts on top of it rather than clipping through. -->
    <model name="landing_pad">
      <static>true</static>
      <pose>0 0 0.02 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>4 4 0.04</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>4 4 0.04</size></box></geometry>
          <material>
            <ambient>0.1 0.1 0.1 1</ambient>
            <diffuse>0.15 0.15 0.15 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <!-- A model of our own, from worlds/models/goal_marker.
         scripts/install-worlds.sh links that directory into PX4's models
         directory, which is already on GZ_SIM_RESOURCE_PATH, and that is what
         makes the bare name resolve with no path in it. Models hosted on
         Gazebo Fuel are included the same way, by URL instead of by name:
         <uri>https://fuel.gazebosim.org/1.0/OpenRobotics/models/Pine Tree</uri>
         which downloads once and is cached in ~/.gz/fuel afterwards. -->
    <include>
      <uri>model://goal_marker</uri>
      <name>goal_north</name>
      <pose>0 25 0 0 0 0</pose>
    </include>

    <include>
      <uri>model://goal_marker</uri>
      <name>goal_east</name>
      <pose>25 0 0 0 0 0</pose>
    </include>

    <!-- Where on Earth this world is. PX4 reports GPS from it, and the home
         position every mission is measured against comes from here. These are
         PX4's own default coordinates, outside Zurich, and they match the
         <magnetic_field> above. Change one and you change both. -->
    <spherical_coordinates>
      <surface_model>EARTH_WGS84</surface_model>
      <world_frame_orientation>ENU</world_frame_orientation>
      <latitude_deg>47.397971057728974</latitude_deg>
      <longitude_deg>8.546163739800146</longitude_deg>
      <elevation>0</elevation>
    </spherical_coordinates>

  </world>
</sdf>
